# ms-ai-generator — variables de entorno
# Copiar a .env y completar con los valores reales
# En Docker el contenedor recibe estas variables desde docker-compose.yml

PORT=8000
ENVIRONMENT=development

# ── Base de datos ──────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=genplan_db
DB_USER=genplan_user
DB_PASSWORD=genplan_pass

# ── Ollama (LLM) ───────────────────────────────────────────────────────────────
# Server 2 con OLLAMA_KEEP_ALIVE=-1 para mantener el modelo en RAM
# Si está vacío o no responde, el servicio usa mock_data como fallback
OLLAMA_URL=http://192.168.100.246:11434
OLLAMA_MODEL=gemma3:4b

# ── ChromaDB (RAG) ─────────────────────────────────────────────────────────────
# Si ChromaDB no está disponible, el servicio genera sin contexto RAG
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=curriculum_pdc
