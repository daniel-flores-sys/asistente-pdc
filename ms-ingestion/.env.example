# ms-ingestion — variables de entorno
# Copiar a .env y completar con los valores reales
# En Docker el contenedor recibe estas variables desde docker-compose.yml

PORT=8003
ENVIRONMENT=development

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8004
CHROMA_COLLECTION=curriculum_pdc

# ── Base de datos ──────────────────────────────────────────────────────────────
# Para registrar metadata de documentos indexados en la tabla documentos_indexados
DB_HOST=postgres
DB_PORT=5432
DB_NAME=genplan_db
DB_USER=genplan_user
DB_PASSWORD=genplan_pass

# ── Ollama (embeddings) ────────────────────────────────────────────────────────
# Modelo de embeddings — nomic-embed-text genera vectores de 768 dims
# Si Ollama no está disponible, ms-ingestion usará all-MiniLM-L6-v2 local como fallback
OLLAMA_URL=http://192.168.100.246:11434
EMBED_MODEL=nomic-embed-text

# ── Configuración de chunking ──────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
