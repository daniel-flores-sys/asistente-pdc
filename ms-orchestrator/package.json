{
  "name": "ms-orchestrator",
  "version": "1.0.0",
  "description": "Microservicio orquestador — coordina el flujo completo de generación de PDC",
  "scripts": {
    "start": "node dist/main",
    "start:dev": "ts-node-dev --respawn --transpile-only --poll src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --require ./node_modules/ts-node/register --test tests/health.test.ts tests/dto.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.0",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "form-data": "^4.0.0",
    "multer": "^1.4.5-lts.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
