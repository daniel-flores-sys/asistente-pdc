# ms-orchestrator — variables de entorno
# Copiar a .env y completar con los valores reales
# En Docker el contenedor recibe estas variables desde docker-compose.yml

PORT=3001
NODE_ENV=development

# ── URLs de microservicios internos ────────────────────────────────────────────
# Usar nombre del servicio Docker como host — la red overlay resuelve el DNS
AI_GENERATOR_URL=http://ms-ai-generator:8000
DOC_PROCESSOR_URL=http://ms-doc-processor:8001
# URL pública del doc-processor accesible desde el navegador del docente
# Local: http://localhost:8001 | Producción: http://192.168.100.245:8001
DOC_PROCESSOR_PUBLIC_URL=http://localhost:8001
INGESTION_URL=http://ms-ingestion:8003
MONITOR_URL=http://ms-monitor:8002

# ── Base de datos ──────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=genplan_db
DB_USER=REEMPLAZAR           # ver security/local.env
DB_PASSWORD=REEMPLAZAR       # ver security/local.env

# ── Autenticación JWT ──────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
JWT_SECRET=REEMPLAZAR_MINIMO_32_CHARS   # ver security/local.env
JWT_EXPIRES_IN=8h

# ── Administrador inicial ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@pdc.edu.bo
ADMIN_PASSWORD=REEMPLAZAR    # ver security/local.env

# ── CORS ───────────────────────────────────────────────────────────────────────
# Origins permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000
