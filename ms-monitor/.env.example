PORT=8002
ENVIRONMENT=development
SCALE_UP_CPU_THRESHOLD=70
SCALE_DOWN_CPU_THRESHOLD=20
SCALE_DOWN_DELAY_MINUTES=5
MAX_REPLICAS=5
MIN_REPLICAS=1
DOCKER_SOCKET=/var/run/docker.sock
MONITOR_USER=root
# Stack name en Docker Swarm (debe coincidir con el usado en docker stack deploy)
SWARM_STACK_NAME=pdc
# Servicios excluidos del auto-scaling (separados por coma)
EXCLUDED_SERVICES=ms-monitor,postgres,chromadb
