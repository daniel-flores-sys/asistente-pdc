# Dockerfile.dev — Imagen de desarrollo con hot-reload
#
# El código fuente NO se copia: viene del volumen montado en docker-compose.dev.yml
# (./ms-doc-processor:/app). Cualquier cambio en el host se refleja de inmediato
# gracias a --reload de uvicorn.

FROM python:3.11-slim

WORKDIR /app

# Instalamos dependencias primero para aprovechar la caché de capas.
# Si solo cambia el código fuente, este paso no se re-ejecuta.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8001

# --reload activa el reinicio automático al detectar cambios en el volumen montado.
CMD ["uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8001", "--reload"]
