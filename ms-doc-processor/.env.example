# ms-doc-processor — variables de entorno
# Copiar a .env y completar con los valores reales
# En Docker el contenedor recibe estas variables desde docker-compose.yml

# ── Servidor ───────────────────────────────────────────────────────────────────
# Puerto donde escucha uvicorn (referencia — el CMD del Dockerfile lo usa fijo en 8001)
PORT=8001

# ── Base de datos ──────────────────────────────────────────────────────────────
# Conexión a PostgreSQL compartida con ms-ai-generator
# En Docker usar el nombre del servicio como host (no localhost)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=genplan_db
DB_USER=REEMPLAZAR           # ver security/local.env
DB_PASSWORD=REEMPLAZAR       # ver security/local.env

# ── Directorio de salida del CLI ───────────────────────────────────────────────
# Solo aplica cuando se ejecuta: python main.py --plan-id N
# El endpoint HTTP /doc/{id}/upload usa memoria (BytesIO), no escribe en disco
OUTPUT_DIR=./output

# ── AWS S3 ─────────────────────────────────────────────────────────────────────
# Credenciales del IAM user pdc-s3-uploader (política s3-read-write-pdc)
# Dejar vacío para usar descarga directa como fallback (válido para demo local)
# En producción configurar vía GitHub Secrets → deploy.yml las inyecta al servidor
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Tiempo de validez de la URL pre-firmada de S3 (en segundos)
# 3600 = 1 hora — después el link expira y hay que generar uno nuevo
S3_PRESIGNED_EXPIRY=3600
